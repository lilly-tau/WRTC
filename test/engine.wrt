REMARK "--- REGISTERS ---"
DECLARE GLOBAL CONSTANT VARIABLE AL AS 00
DECLARE GLOBAL CONSTANT VARIABLE CL AS 01
DECLARE GLOBAL CONSTANT VARIABLE DL AS 02
DECLARE GLOBAL CONSTANT VARIABLE BL AS 03
DECLARE GLOBAL CONSTANT VARIABLE AH AS 04
DECLARE GLOBAL CONSTANT VARIABLE CH AS 05
DECLARE GLOBAL CONSTANT VARIABLE DH AS 06
DECLARE GLOBAL CONSTANT VARIABLE BH AS 07
DECLARE GLOBAL CONSTANT VARIABLE AX AS 08
DECLARE GLOBAL CONSTANT VARIABLE CX AS 09
DECLARE GLOBAL CONSTANT VARIABLE DX AS 0A
DECLARE GLOBAL CONSTANT VARIABLE BX AS 0B
DECLARE GLOBAL CONSTANT VARIABLE SP AS 0C
DECLARE GLOBAL CONSTANT VARIABLE BP AS 0D
DECLARE GLOBAL CONSTANT VARIABLE SI AS 0E
DECLARE GLOBAL CONSTANT VARIABLE DI AS 0F

REMARK "--- INSTRUCTIONS ---"

DECLARE GLOBAL PROCEDURE LDI ( REGISTER DATA )
	DECLARE LOCAL VARIABLE INSTRUCTION

	MOVE REGISTER INTO INSTRUCTION
	$ OR 0B0 WITH INSTRUCTION

	$ AND 08 WITH REGISTER
	IF REGISTER IS ZERO		REMARK "8 BIT REGISTER"
		$ AND 0FF WITH DATA
		WRITE INSTRUCTION DATA THEN
	ELSE
		DECLARE LOCAL VARIABLE LOW	AS DATA
		DECLARE LOCAL VARIABLE HIGH	AS DATA

		$ AND 0FF WITH LOW
		$ SHR HIGH BY 08

		WRITE INSTRUCTION LOW HIGH THEN
	END-IF
END-PROCEDURE

DECLARE GLOBAL PROCEDURE INT ( INTERRUPT )
	$ AND 0FF WITH INTERRUPT
	WRITE 0CD INTERRUPT THEN
END-PROCEDURE

DECLARE GLOBAL CONSTANT PROCEDURE HLT AS 0F4 THEN

